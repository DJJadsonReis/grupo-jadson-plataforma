# Runtime
NODE_ENV=development
APP_NAME=Grupo Jadson
APP_ENV=local
API_PORT=3333
API_HOST=127.0.0.1
API_BASE_URL=http://127.0.0.1:3333
VITE_API_BASE_URL=http://127.0.0.1:3333/api/v1

# Database
POSTGRES_PASSWORD=change_me
DATABASE_URL=postgresql://grupo_jadson:change_me@localhost:5432/grupo_jadson
REDIS_URL=redis://localhost:6379
QUEUE_DRIVER=local

# Security — gere segredos fortes antes de qualquer deploy
# API_TOKEN protege todas as rotas da API (exceto /health). Mínimo de 32 caracteres.
# GJ_DEV_API_TOKEN (só desenvolvimento) deve ser o mesmo valor de API_TOKEN; o desktop o recebe do servidor Vite, não do bundle.
API_TOKEN=
GJ_DEV_API_TOKEN=
APP_ENCRYPTION_KEY=
JWT_SECRET=

# AI providers — configure somente os provedores que utilizar
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_BASE_URL=https://api.openai.com/v1/chat/completions
ANTHROPIC_API_KEY=
GOOGLE_AI_API_KEY=
XAI_API_KEY=
OPENROUTER_API_KEY=
OLLAMA_BASE_URL=http://localhost:11434

# Storage
S3_ENDPOINT=http://localhost:9000
S3_BUCKET=grupo-jadson
S3_ACCESS_KEY=
S3_SECRET_KEY=
