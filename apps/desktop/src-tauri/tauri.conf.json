{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Grupo Jadson",
  "version": "0.1.0",
  "identifier": "br.com.grupojadson.desktop",
  "build": {
    "beforeDevCommand": "pnpm dev:web",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [{ "title": "Grupo Jadson", "width": 1440, "height": 920, "minWidth": 360, "minHeight": 620 }],
    "security": { "csp": "default-src 'self'; connect-src ipc: http://ipc.localhost http://localhost:3333 http://127.0.0.1:3333; img-src 'self' asset: http://asset.localhost data: blob:; style-src 'self' 'unsafe-inline'; script-src 'self'" }
  },
  "bundle": { "active": true, "targets": ["msi", "nsis"], "icon": ["../src/assets/grupo-jadson-logo.png"], "category": "Productivity", "shortDescription": "Plataforma de agentes de IA" }
}
